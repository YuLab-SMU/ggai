            "axis": "x"
          }
        }
      }
    ],
    "edges": [
      {
        "from": "ingest",
        "to": "process",
        "label": null,
        "arrow": true,
        "style": {
          "colour": "#334455"
        },
        "route": "straight"
      },
      {
        "from": "process",
        "to": "serve",
        "label": null,
        "arrow": true,
        "style": {
          "colour": "#334455"
        },
        "route": "straight"
      },
      {
        "from": "monitor",
        "to": "serve",
        "label": null,
        "arrow": true,
        "style": {
          "colour": "#334455"
        },
        "route": "elbow"
      }
    ],
    "annotations": []
  }
