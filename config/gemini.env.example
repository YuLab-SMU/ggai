# Gemini runtime config for ggai + aisdk
#
# Usage options:
# 1. Copy this file to `.env.gemini` and load it manually in R with dotenv::load_dot_env()
# 2. Or copy the values into your `~/.Renviron`
# 3. Or export them in the shell before running tests/examples

# Required
GEMINI_API_KEY=your_gemini_api_key_here

# Optional provider endpoint override
# Default in aisdk:
# https://generativelanguage.googleapis.com/v1beta/models
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# Optional default language model for compiler calls
# Good starting options:
# gemini-2.5-flash
# gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Optional default image model for glyph/image generation
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# Optional ggai defaults
GGAI_LANGUAGE_MODEL=gemini:gemini-2.5-flash
GGAI_IMAGE_MODEL=gemini:gemini-3.1-flash-image-preview
GGAI_DIAGRAM_THEME=paper

# Optional live test toggle
# Set to true only when you want to run the live compiler integration test
GGAI_RUN_LIVE_COMPILER=false

# Optional compiler behavior
# Number of compiler attempts before giving up
GGAI_COMPILER_MAX_ATTEMPTS=2

# Optional compiler review pass
# true / false
GGAI_REVIEW_COMPILER_OUTPUT=false
